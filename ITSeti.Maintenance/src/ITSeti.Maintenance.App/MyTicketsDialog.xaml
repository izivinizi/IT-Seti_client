<Window x:Class="ITSeti.Maintenance.App.MyTicketsDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="ИТ-Сети | Мои заявки" Icon="Assets/favicon.ico" Width="940" Height="680" MinWidth="720" MinHeight="500" WindowStartupLocation="CenterOwner" Background="White" FontFamily="Segoe UI" FontSize="14" Loaded="Window_Loaded">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="SupportStyles.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>
  <Grid Background="White">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Border BorderBrush="#E0E6ED" BorderThickness="0,0,0,1" Padding="22,16">
      <DockPanel>
        <Button x:Name="RefreshButton" DockPanel.Dock="Right" Content="Обновить" Click="Refresh_Click" />
        <TextBlock Text="Мои заявки" FontSize="22" FontWeight="SemiBold" Foreground="#143C87" VerticalAlignment="Center" />
      </DockPanel>
    </Border>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="250" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Border Background="#F5F7FA" BorderBrush="#E0E6ED" BorderThickness="0,0,1,0" Padding="12">
        <Grid>
          <ListBox x:Name="Tickets" SelectionChanged="Tickets_SelectionChanged" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Padding" Value="12,10" />
                <Setter Property="Margin" Value="0,0,0,6" />
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                      <Border x:Name="Surface" Background="White" BorderBrush="#E0E6ED" BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                          <Setter TargetName="Surface" Property="Background" Value="#E9F0FF" />
                          <Setter TargetName="Surface" Property="BorderBrush" Value="#326EFF" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter TargetName="Surface" Property="BorderBrush" Value="#90AFE3" />
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel>
                  <TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding StateLabel}" FontSize="12" Foreground="#63748A" Margin="0,5,0,0" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock x:Name="EmptyTickets" Text="Заявок пока нет" Foreground="#63748A" Margin="12" Visibility="Collapsed" />
        </Grid>
      </Border>
      <Grid Grid.Column="1" Margin="20,16,20,16">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,12">
          <TextBlock x:Name="TicketHeader" Text="Выберите заявку" FontSize="18" FontWeight="SemiBold" Foreground="#143C87" />
          <TextBlock x:Name="TicketState" Foreground="#63748A" FontSize="12" Margin="0,4,0,0" />
        </StackPanel>
        <ListBox x:Name="Messages" Grid.Row="1" BorderThickness="0" Background="#F5F7FA" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
              <Setter Property="HorizontalContentAlignment" Value="Stretch" />
              <Setter Property="Focusable" Value="False" />
              <Setter Property="Padding" Value="0" />
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="ListBoxItem">
                    <ContentPresenter />
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Border x:Name="MessageSurface" Background="White" BorderBrush="#BECBD9" BorderThickness="1" CornerRadius="4" Padding="12" Margin="10,8,30,0">
                <StackPanel>
                  <DockPanel>
                    <TextBlock Text="{Binding Date}" FontSize="11" Foreground="#63748A" DockPanel.Dock="Right" />
                    <TextBlock Text="{Binding Author}" FontWeight="SemiBold" FontSize="13" />
                  </DockPanel>
                  <TextBlock Text="{Binding Content}" TextWrapping="Wrap" Margin="0,6,0,0" />
                  <ItemsControl ItemsSource="{Binding Attachments}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Button Click="Download_Click" Tag="{Binding}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,8,0,0" ToolTip="Скачать вложение">
                          <DockPanel LastChildFill="True">
                            <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding FileName}" TextWrapping="Wrap" />
                          </DockPanel>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
              <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsEngineer}" Value="False">
                  <Setter TargetName="MessageSurface" Property="Background" Value="#E9F0FF" />
                  <Setter TargetName="MessageSurface" Property="Margin" Value="30,8,10,0" />
                </DataTrigger>
              </DataTemplate.Triggers>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Grid.Row="3" Margin="0,12,0,0">
          <TextBlock Text="Ответ" Style="{StaticResource FieldLabel}" />
          <TextBox x:Name="ReplyBody" AcceptsReturn="True" MaxLength="5000" TextWrapping="Wrap" Height="86" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" PreviewKeyDown="ReplyBody_PreviewKeyDown" IsEnabled="False" />
          <TextBlock x:Name="AttachmentLabel" FontSize="12" Foreground="#63748A" Margin="0,6,0,0" />
          <DockPanel Margin="0,8,0,0">
            <Button x:Name="SendButton" DockPanel.Dock="Right" Content="Отправить ответ" Click="Send_Click" IsEnabled="False" Style="{StaticResource PrimaryActionButton}" />
            <Button x:Name="AttachButton" Click="Attach_Click" HorizontalAlignment="Left" IsEnabled="False">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="" FontFamily="Segoe MDL2 Assets" Margin="0,0,8,0" />
                <TextBlock Text="Прикрепить файл" />
              </StackPanel>
            </Button>
          </DockPanel>
        </StackPanel>
      </Grid>
    </Grid>
    <Border Grid.Row="2" Padding="22,0">
      <TextBlock x:Name="StatusText" Style="{StaticResource OptionalStatus}" />
    </Border>
  </Grid>
</Window>
