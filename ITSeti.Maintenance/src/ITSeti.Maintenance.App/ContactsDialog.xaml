<Window x:Class="ITSeti.Maintenance.App.ContactsDialog"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="ИТ-Сети | Контакты" Icon="Assets/favicon.ico" Width="490" Height="510" MinWidth="360" MinHeight="350"
 WindowStartupLocation="CenterOwner" Background="White" FontFamily="Segoe UI" FontSize="14">
 <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="24">
  <TextBlock Text="Контакты ИТ-Сети" FontSize="22" FontWeight="SemiBold" Foreground="#143C87" Margin="0,0,0,18"/>
  <TextBlock Text="+7 (343) 243-57-63" FontSize="18" Foreground="#203A50"/>
  <TextBlock Text="Кнопка 2 в голосовом меню" Foreground="#526477" Margin="0,4,0,16"/>
  <TextBlock Margin="0,0,0,12"><Hyperlink NavigateUri="mailto:support@it-seti.ru" RequestNavigate="OpenLink">support@it-seti.ru</Hyperlink></TextBlock>
  <TextBlock Margin="0,0,0,12"><Hyperlink NavigateUri="https://t.me/it_seti_support_bot" RequestNavigate="OpenLink">Telegram</Hyperlink></TextBlock>
  <TextBlock Margin="0,0,0,20"><Hyperlink NavigateUri="https://max.ru/id6670529055_bot" RequestNavigate="OpenLink">MAX</Hyperlink></TextBlock>
  <Separator/>
  <TextBlock Text="Данные компьютера" FontWeight="SemiBold" Foreground="#143C87" Margin="0,16,0,8"/>
  <TextBox x:Name="IdentityValue" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Padding="0,4" Background="Transparent"/>
  <Button Content="Копировать данные ПК" Click="Copy_Click" HorizontalAlignment="Left" Padding="12,8" Margin="0,12,0,0" Background="White" BorderBrush="#C8D5E2"/>
  <TextBlock x:Name="CopyStatus" TextWrapping="Wrap" Foreground="#24796F" Margin="0,8,0,0"/>
 </StackPanel></ScrollViewer>
</Window>
