<Window x:Class="ITSeti.Maintenance.App.SupportDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="ИТ-Сети | Новая заявка" Icon="Assets/favicon.ico" Width="940" Height="780" MinWidth="540" MinHeight="480" ResizeMode="CanResize" WindowStartupLocation="CenterOwner" Background="White" FontFamily="Segoe UI" FontSize="14">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="SupportStyles.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>
  <Grid Background="White">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Border BorderBrush="#E0E6ED" BorderThickness="0,0,0,1" Padding="22,16">
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="Контакты" Click="Contacts_Click" />
        <TextBlock Text="Новая заявка" FontSize="22" FontWeight="SemiBold" Foreground="#143C87" VerticalAlignment="Center" />
      </DockPanel>
    </Border>
    <ScrollViewer x:Name="Composer" Grid.Row="1" Margin="22,18,22,16" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <Grid MinHeight="{Binding ViewportHeight, ElementName=Composer}">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,16">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="2*" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="Тема" Style="{StaticResource FieldLabel}" />
            <TextBox x:Name="TicketTitle" MaxLength="200" Height="38" />
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Text="Сервис" Style="{StaticResource FieldLabel}" />
            <ComboBox x:Name="TicketService" DisplayMemberPath="Name" SelectedValuePath="Code" Height="38" />
          </StackPanel>
        </Grid>
        <TextBlock Grid.Row="1" Text="Суть заявки" Style="{StaticResource FieldLabel}" />
        <TextBox Grid.Row="2" x:Name="TicketBody" MaxLength="5000" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="150" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" PreviewKeyDown="TicketBody_PreviewKeyDown" Margin="0,0,0,16" />
        <StackPanel Grid.Row="3">
        <TextBlock Text="Контактные данные" Style="{StaticResource FieldLabel}" />
        <TextBox x:Name="TicketContact" MaxLength="300" Height="38" ToolTip="Телефон или электронная почта" Margin="0,0,0,14" />
        <CheckBox x:Name="IncludePcInfo" Content="Добавить данные о ПК" IsChecked="True" FontSize="14" Foreground="#25384C" ToolTip="Инвентарный номер, RMS и AnyDesk" Margin="0,0,0,14" />
        <DockPanel>
          <Button x:Name="RemoveAttachment" DockPanel.Dock="Right" IsEnabled="False" Click="RemoveFile_Click" ToolTip="Удалить выбранное вложение" AutomationProperties.Name="Удалить выбранное вложение">
            <Button.Style>
              <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Style.Triggers>
                  <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Visibility" Value="Collapsed" />
                  </Trigger>
                </Style.Triggers>
              </Style>
            </Button.Style>
            <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" />
          </Button>
          <Button Click="Attach_Click" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="" FontFamily="Segoe MDL2 Assets" Margin="0,0,8,0" />
              <TextBlock Text="Прикрепить файл" />
            </StackPanel>
          </Button>
        </DockPanel>
        <ListBox x:Name="TicketFiles" Margin="0,8,0,0" MaxHeight="72" BorderThickness="0" FontSize="13" />
        </StackPanel>
      </Grid>
    </ScrollViewer>
    <Border Grid.Row="2" BorderBrush="#E0E6ED" BorderThickness="0,1,0,0" Background="#F5F7FA" Padding="22,14">
      <StackPanel>
        <TextBlock x:Name="TicketStatus" Style="{StaticResource OptionalStatus}" />
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Button x:Name="MyTicketsButton" Content="Мои заявки" Click="MyTickets_Click" HorizontalAlignment="Left" />
          <Button Grid.Column="1" Content="Закрыть" Click="Close_Click" Margin="8,0" />
          <Button Grid.Column="2" x:Name="SubmitTicket" Content="Отправить заявку" Click="SubmitTicket_Click" Style="{StaticResource PrimaryActionButton}" />
        </Grid>
      </StackPanel>
    </Border>
  </Grid>
</Window>
