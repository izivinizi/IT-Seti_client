<Window x:Class="ITSeti.Maintenance.App.ServerAssignmentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Компания и объект ПК" Width="650" Height="390" MinWidth="560" MinHeight="340"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" Background="#F4F7FA">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <TextBlock Text="Компания и объект ПК" FontSize="24" FontWeight="SemiBold" Foreground="#143C87"/>
    <TextBlock Grid.Row="1" Text="Выберите компанию. Объект можно оставить пустым." Foreground="#40566A" Margin="0,8,0,18"/>
    <Grid Grid.Row="2" Margin="0,0,0,12">
      <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <TextBlock Text="Компания" VerticalAlignment="Center" FontWeight="SemiBold"/>
      <ComboBox x:Name="CompanyBox" Grid.Column="1" IsEditable="True" IsTextSearchEnabled="False" Height="34"
                DisplayMemberPath="Name" SelectionChanged="CompanyBox_SelectionChanged"/>
    </Grid>
    <Grid Grid.Row="3" Margin="0,0,0,12">
      <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <TextBlock Text="Объект" VerticalAlignment="Center" FontWeight="SemiBold"/>
      <ComboBox x:Name="SiteBox" Grid.Column="1" IsEditable="True" IsTextSearchEnabled="False" Height="34"
                DisplayMemberPath="DisplayName" SelectionChanged="SiteBox_SelectionChanged"/>
    </Grid>
    <TextBlock x:Name="StatusText" Grid.Row="4" Foreground="#40566A" TextWrapping="Wrap"/>
    <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="Отмена" Width="108" Height="36" Margin="0,0,10,0" Click="Cancel_Click"/>
      <Button x:Name="SaveButton" Content="Сохранить" Width="126" Height="36" IsDefault="True" IsEnabled="False" Click="Save_Click"/>
    </StackPanel>
  </Grid>
</Window>
